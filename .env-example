#==== Vonage API ====

#-- From dashboard.nexmo.com --
API_KEY=xxxxxxx
API_SECRET=xxxxxxxxxxx

#-- Application ID (from dashboard.vonage.com) --
APP_ID=xxxxxxxxxxxx

#-- A Vonage API number linked to the application above (from dashboard.nexmo.com) --
#-- Must be in E.164 format without leading '+' sign --
SERVICE_PHONE_NUMBER=12995550101

#-- API base URL (uncomment the one to be used) --
# API_BASE_URL=https://api-ap.vonage.com
# API_BASE_URL=https://api-eu.vonage.com
API_BASE_URL=https://api-us.vonage.com

#==== Middleware server ====

# Back end server host name (no prefix such as "https://" or "wss://", and no trailing slash "/")
PROCESSOR_SERVER=xxxx.ngrok.xx

#==== Other parameters ====

# Maximum duration for outbound calls in seconds (for demos)
MAX_CALL_DURATION = 300

# Human agent - For demo
#-- Must be in E.164 format without leading '+' sign --
HUMAN_AGENT_PHONE_NUMBER=12995557890
